---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { galleryAlbums, getLightboxImage, type GalleryAlbum } from '../../lib/gallery';

export function getStaticPaths() {
    return galleryAlbums.map((album) => ({
        params: { album: album.slug },
        props: { album },
    }));
}

interface Props {
    album: GalleryAlbum
}
const { album } = Astro.props;
const photos = await Promise.all(album.photos.map(async (photo) => (
    { ...photo, lightbox: await getLightboxImage(photo) }
)));
---

<BaseLayout title={album.title}>
    <header>
        <p><a href="/photos/">← Photos</a></p>
        <h1>{album.title}</h1>
        {album.description && <p>{album.description}</p>}
    </header>

    <div id="gallery">
        {photos.map((photo) => (
            <figure>
                <a
                    href={photo.lightbox.src}
                    data-pswp-width={photo.lightbox.width}
                    data-pswp-height={photo.lightbox.height}
                    target="_blank"
                >
                    <Image src={photo.original} width={600} height={600} fit="cover" alt={photo.title} />
                </a>
                <!-- read by the PhotoSwipe caption plugin -->
                <div class="pswp-caption-content" hidden>
                    <strong>{photo.title}</strong>
                    {photo.description && <p>{photo.description}</p>}
                    <p>{[photo.dateText, photo.location].filter(Boolean).join(', ')}</p>
                    {(photo.camera || photo.lens || photo.exposure) && (
                        <p>{[photo.camera, photo.lens, photo.exposure].filter(Boolean).join(', ')}</p>
                    )}
                    <p>
                        © {photo.author},
                        {photo.licenseUrl
                            ? <a href={photo.licenseUrl}>{photo.license}</a>
                            : 'all rights reserved'}
                    </p>
                </div>
            </figure>
        ))}
    </div>
</BaseLayout>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import PhotoSwipeDynamicCaption from 'photoswipe-dynamic-caption-plugin';
    import 'photoswipe/style.css';
    import 'photoswipe-dynamic-caption-plugin/photoswipe-dynamic-caption-plugin.css';

    const lightbox = new PhotoSwipeLightbox({
        gallery: '#gallery',
        children: 'figure', // PhotoSwipe opens the first link inside
        pswpModule: () => import('photoswipe'),
    });
    new PhotoSwipeDynamicCaption(lightbox, { type: 'auto' });
    lightbox.init();
</script>

<style>
    #gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
        gap: 0.5rem;
    }

    #gallery figure {
        margin: 0;
    }

    #gallery img {
        display: block;
        width: 100%;
        height: auto;
    }
</style>
