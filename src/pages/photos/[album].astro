---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { albums, type GalleryAlbum } from '../../lib/gallery';
import LightboxPhoto from '../../components/LightboxPhoto.astro';

// gets called by Astro to fill the [album].astro pages
export function getStaticPaths() {
    return albums.map((album) => ({
        params: { album: album.slug },
        props: { album },
    }));
}

interface Props {
    album: GalleryAlbum
}
const { album } = Astro.props;
---

<BaseLayout title={album.title}>
    <header>
        <p><a href="/photos/">← Photos</a></p>
        <h1>{album.title}</h1>
        {album.description && <p>{album.description}</p>}
    </header>

    <div id="gallery">
        {album.photos.map((photo) => (
            <LightboxPhoto photo={photo} />
        ))}
    </div>
</BaseLayout>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import PhotoSwipeDynamicCaption from 'photoswipe-dynamic-caption-plugin';
    import 'photoswipe/style.css';
    import 'photoswipe-dynamic-caption-plugin/photoswipe-dynamic-caption-plugin.css';

    const lightbox = new PhotoSwipeLightbox({
        gallery: '#gallery',
        children: 'figure', // PhotoSwipe opens the first link inside
        showHideAnimationType: 'none',
        pswpModule: () => import('photoswipe'),
    });
    new PhotoSwipeDynamicCaption(lightbox, { type: 'auto' });
    lightbox.init();
</script>

<style>
    #gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
        gap: 0.5rem;
    }
</style>
