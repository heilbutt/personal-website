---
import Navigation from './Navigation.astro';
---

<header>
    <div>
        <Navigation />
    </div>
</header>

<style>
    header {
        position: sticky;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        top: 0;
        z-index: 1000;
        background-color: color-mix(in srgb, var(--bg-0) 50%, transparent 50%);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 0 16px var(--color-shadow);
    }

    /* inner container that is aligned with main content */
    header > div {
        margin: 0 auto;
        width: var(--max-width);
    }
</style>
