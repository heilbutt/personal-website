---
// Publication category containing multiple publications

import { type PublicationCategory } from '../lib/publications';
import Publication from './Publication.astro'

interface Props {
    publicationCategory: PublicationCategory
}
const { publicationCategory } = Astro.props;
---

<section class="publication-category">
    <h2 id={publicationCategory.slug}>{publicationCategory.heading}</h2>
    <div>
        {publicationCategory.publications.map((pub) => <Publication publication={pub} />)}
    </div>
</section>

<style>
    .publication-category > div {
        display: grid;
        gap: 1rem;
    }
</style>