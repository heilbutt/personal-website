---
import type { Publication } from '../lib/publications';

interface Props {
    publication: Publication
}
const { publication } = Astro.props;
---

<article>
    <h3>{publication.title}</h3>
    <p class="authors">{publication.authors}</p>
    <p class="meta">{publication.meta}</p>
    {publication.link && <p class="link">
        {publication.link.prefix}<a href={publication.link.href}>
            {publication.link.text}
        </a>
    </p>}
</article>

<style>
    article {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1rem;
        box-shadow: 0 4px 16px var(--color-shadow);
        transition: 200ms ease;
    }

    article:is(:hover, :focus-within) {
        background: radial-gradient(ellipse at bottom right, var(--color-surface-hover), var(--bg-0));
        border-color: var(--gray);
    }

    article>h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: normal;
        line-height: 1.2;
        letter-spacing: 0.01em;
    }

    article>p {
        margin-top: 0.3rem;
        margin-bottom: 0;
        color: var(--color-text-muted);
    }

    article>p.link {
        font-family: var(--font-mono);
        font-weight: bold;
    }
</style>